   bool hadErrors_ = false;
 
+  static kj::Maybe<kj::String> getExecutablePath() {
+    // Returns the absolute path of the running executable, with symlinks resolved.
+#if _WIN32
+    wchar_t buffer[32768];
+    DWORD len = GetModuleFileNameW(nullptr, buffer, kj::size(buffer));
+    if (len == 0 || len >= kj::size(buffer)) return kj::none;
+    auto result = kj::decodeWideString(kj::arrayPtr(buffer, len));
+    if (result.hadErrors) return kj::none;
+    return kj::String(kj::mv(result));
+#elif __APPLE__ || __linux__
+#if __APPLE__
+    uint32_t size = 0;
+    _NSGetExecutablePath(nullptr, &size);
+    auto buffer = kj::heapArray<char>(size);
+    if (_NSGetExecutablePath(buffer.begin(), &size) != 0) return kj::none;
+    const char* path = buffer.begin();
+#else
+    const char* path = "/proc/self/exe";
+#endif
+    char* resolved = realpath(path, nullptr);
+    if (resolved == nullptr) return kj::none;
+    KJ_DEFER(free(resolved));
+    return kj::str(resolved);
+#else
+    return kj::none;
+#endif
+  }
